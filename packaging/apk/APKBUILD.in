# Maintainer: Kevin Yue <k3vinyue@gmail.com>

pkgname=@PKG_NAME@
pkgver=@VERSION@
pkgrel=@REVISION@
pkgdesc="A GUI client for GlobalProtect VPN, based on OpenConnect, supports the SSO authentication method."
url="https://github.com/yuezk/GlobalProtect-openconnect"
arch="x86_64 aarch64"
license="GPL-3.0-only"
depends="
	gmp
	gnutls
	libsecret
	libxml2
	lz4
	nettle
	p11-kit
	polkit
	webkit2gtk-4.1
	xdg-utils
	zlib
	"
makedepends="
	autoconf
	automake
	cargo
	file
	gettext-dev
	gmp-dev
	gnutls-dev
	gtk+3.0-dev
	libsecret-dev
	librsvg-dev
	libtool
	libxml2-dev
	lz4-dev
	make
	nettle-dev
	p11-kit-dev
	patch
	pkgconf
	zlib-dev
	"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
install="$pkgname.post-deinstall"
options="!check"
# GTK4 is loaded only by the optional Native Shell. Keep dependency tracing for the rest of the package.
somask="libgtk-4.so.1 libgraphene-1.0.so.0"

build() {
	cd "$builddir"

	unset CFLAGS
	unset RUSTFLAGS

	make build \
		INCLUDE_GUI="${INCLUDE_GUI:-0}" \
		BUILD_GUI_HELPER="${BUILD_GUI_HELPER:-1}" \
		BUILD_WEBVIEW_AUTH="${BUILD_WEBVIEW_AUTH:-1}" \
		LIBXML2_STATIC="${LIBXML2_STATIC:-1}"
}

package() {
	cd "$builddir"

	make install \
		DESTDIR="$pkgdir" \
		INCLUDE_GUI="${INCLUDE_GUI:-0}" \
		BUILD_GUI_HELPER="${BUILD_GUI_HELPER:-1}"
}

sha512sums="
@SHA512@  $pkgname-$pkgver.tar.gz
"
